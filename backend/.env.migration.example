# 映想隔离迁移环境。复制到同目录 .env.migration.local 后填写；不要改当前 .env。
# 本文件只有示例，不能包含真实密码。migration_env只离线检查，不会连接或写入云资源。
MIGRATION_PROFILE=isolated
MIGRATION_PUBLIC_ORIGIN=http://127.0.0.1:8791
MIGRATION_API_PORT=8792
MIGRATION_STORAGE_ROOT=data/migration-test

# 独立 PostgreSQL 测试库；禁止填写正式业务库。
MIGRATION_DB_HOST=
MIGRATION_DB_PORT=5432
MIGRATION_DB_NAME=yingxiang_migration_test
MIGRATION_DB_SCHEMA=yingxiang_migration
MIGRATION_DB_USERNAME=
MIGRATION_DB_PASSWORD=
MIGRATION_DB_SSLMODE=verify-full
# 云平台要求自带CA时填写本机证书路径；否则留空，实施时核对驱动信任链。
MIGRATION_DB_SSLROOTCERT=

# Redis隔离测试命名空间；ACL用户名可选，密码必须填写。
MIGRATION_REDIS_HOST=
MIGRATION_REDIS_PORT=6379
MIGRATION_REDIS_USERNAME=
MIGRATION_REDIS_PASSWORD=
MIGRATION_REDIS_TLS=true
MIGRATION_REDIS_DATABASE=0
MIGRATION_REDIS_NAMESPACE=yingxiang:migration:test

# 安全默认值：此阶段不允许真实模型／支付调用，不启用生成，不自动解除维护。
MIGRATION_MAINTENANCE=true
MIGRATION_ALLOW_EXTERNAL_PROVIDERS=false
MIGRATION_SCENES_ENABLED=false
MIGRATION_STRIPE_LIVE_ENABLED=false
