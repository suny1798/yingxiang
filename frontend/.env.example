NEXT_TELEMETRY_DISABLED=1
# 本机实时换装入口；需登录及对应时长权益，不代表已实现硬账单额度。
YINGXIANG_STUDIO_ENABLED=false
DECART_API_KEY=
# 视频换装独立门禁；仅在明确批准新预算后配置，不能沿用实时测试授权。
# 按向上取整秒数×$0.04保守预留，终态/失败/过期都不自动返还。
# 0 < 总预算 <= 5美元，任务数1—20；既有本地任务累计占用，不按重启重置。
YINGXIANG_VIDEO_ENABLED=false
YINGXIANG_VIDEO_BUDGET_USD=
YINGXIANG_VIDEO_MAX_JOBS=
# Lucy2.5纯提示词实时编辑；独立默认关闭，需批准新预算后配置。
# 每次15秒，保守预留$0.30；预算$0.30—$5，次数1—20，不自动退款/重置。
YINGXIANG_PROMPT_ENABLED=false
YINGXIANG_PROMPT_BUDGET_USD=
YINGXIANG_PROMPT_MAX_SESSIONS=
# 不要把任何长期密钥放入 NEXT_PUBLIC_* 变量。

# Stripe 仅沙盒。配置完成后才将开关改为true；禁止live密钥。
YINGXIANG_PAYMENTS_TEST_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPECTED_ACCOUNT_ID=
