{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true,
    "esModuleInterop": true, "isolatedModules": true,
    "types": ["vite/client", "node"], "paths": {"@/*": ["./src/*"]}
  },
  "include": ["src/vue/**/*.ts", "src/vue/**/*.vue", "vite.config.mts", "scripts/sdk-vite-check.ts"]
}
