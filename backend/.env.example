# 路径相对 backend，运行时绝不自动创建数据库；先显式执行 Alembic。
DATA_DIR=data
PUBLIC_ORIGIN=http://127.0.0.1:8787
ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
MAINTENANCE=true
# 当前随 Python 提供的 SQLite 采用 DELETE/FULL；WAL 需验证修复版本后显式选用。
SQLITE_JOURNAL_MODE=DELETE
YINGXIANG_STUDIO_ENABLED=false
DECART_API_KEY=
YINGXIANG_PROMPT_ENABLED=false
YINGXIANG_PROMPT_BUDGET_USD=0
YINGXIANG_PROMPT_MAX_SESSIONS=0
YINGXIANG_VIDEO_ENABLED=false
YINGXIANG_VIDEO_BUDGET_USD=0
YINGXIANG_VIDEO_MAX_JOBS=0
YINGXIANG_PAYMENTS_TEST_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPECTED_ACCOUNT_ID=

# 可选：仅允许指定已有账号使用相应内测场景；空值沿用全局范围。
YINGXIANG_VIDEO_ALLOWED_USERNAMES=
YINGXIANG_PROMPT_ALLOWED_USERNAMES=

# 显式指定可不限次数/累计预算、无申请冷却的提示词测试账号；仍需登录及场景白名单。
YINGXIANG_PROMPT_UNLIMITED_USERNAMES=
